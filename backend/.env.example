# Airfare Price Index (APIx) - Backend Environment Configuration

# Application
PROJECT_NAME="Airfare Price Index (APIx)"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"

# Server
HOST="127.0.0.1"
PORT=8000

# Database
# Default local SQLite database (for immediate zero-configuration execution):
DATABASE_URL="sqlite:///./apix.db"
USE_SQLITE_FALLBACK=True

# To use PostgreSQL in production or staging, comment out the sqlite line above and configure:
# POSTGRES_SERVER="localhost"
# POSTGRES_PORT=5432
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="postgres_password"
# POSTGRES_DB="apix_db"
# DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/apix_db"

# CORS Configuration (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]
